---
import { satellites } from "../data/site";
---

{
	satellites.map((sat) => (
		<a class="sat" href={sat.href} data-satellite={sat.key} style={`left:${sat.left}%;top:${sat.top}%`}>
			{sat.key === "plugins" && (
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<rect x="4" y="9" width="12" height="11" rx="2" />
					<path d="M8 9V5h4v4" />
					<path class="dim" d="M16 14h4" />
					<circle class="ac" cx="20" cy="14" r="1.2" />
				</svg>
			)}
			{sat.key === "themes" && (
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="8" />
					<circle class="ac" cx="9" cy="10" r="1.3" />
					<circle cx="14.5" cy="9" r="1.1" />
					<circle cx="15.5" cy="14" r="1.1" />
					<path class="dim" d="M12 20a2.4 2.4 0 0 1 0-4.8h1.6" />
				</svg>
			)}
			{sat.key === "solidcore" && (
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M12 2.5l8.5 4.9v9.2L12 21.5l-8.5-4.9V7.4z" />
					<path class="dim" d="M12 7.7V2.5M15.8 9.9l4.7-2.5M15.8 14.1l4.7 2.5M12 16.3v5.2M8.2 14.1l-4.7 2.5M8.2 9.9L3.5 7.4" />
					<path class="core" d="M12 7.7l3.8 2.2v4.2L12 16.3l-3.8-2.2V9.9z" />
					<path class="core-l" d="M12 12L8.2 9.9M12 12l3.8-2.1M12 12v4.3" />
				</svg>
			)}
			{sat.key === "agents" && (
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12.5" r="2.4" />
					<circle class="ac" cx="12" cy="12.5" r="0.9" />
					<circle cx="4.5" cy="6" r="1.8" />
					<circle cx="19.5" cy="6" r="1.8" />
					<circle cx="12" cy="21" r="1.8" />
					<path d="M10.19 10.93L5.86 7.18M13.81 10.93l4.33-3.75M12 14.9v4.3" />
				</svg>
			)}
			<span>
				{sat.label}
				<small>{sat.sub}</small>
			</span>
		</a>
	))
}
