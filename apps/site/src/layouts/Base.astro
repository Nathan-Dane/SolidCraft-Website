---
import Backdrop from "../components/Backdrop.astro";
import Bar from "../components/Bar.astro";
import BrandSprite from "../components/BrandSprite.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import { site } from "../data/site";
import { url } from "../lib/url";

interface Props {
	title: string;
	description?: string;
	/** The page has the hero, so the backdrop carries the field. */
	hero?: boolean;
	/** The id of the element that ends the content the first paint needs; the page is not painted before it is parsed. */
	expect?: string;
}

const { title, description = site.description, expect, hero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL(url("/og.png"), Astro.site);
const speculation = { prefetch: [{ where: { href_matches: url("/*") }, eagerness: "moderate" }] };
const data = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: site.name,
	url: site.url,
	description,
	publisher: { "@type": "Organization", name: "Tangency Labs" },
};
// Decides before the first paint whether the entrance plays: once per session, never for reduced motion, data saver, a scrolled
// load or ?nointro (?intro plays it again). If it has not started within 2.5 s, the page shows itself regardless.
const gate = `(function(d){try{var q=location.search;if(matchMedia("(prefers-reduced-motion: reduce)").matches&&!/[?&]motion/.test(q))return;if(scrollY>=40||/[?&]nointro/.test(q)||(navigator.connection&&navigator.connection.saveData))return;var s=sessionStorage;if(!/[?&]intro/.test(q)&&s.getItem("sc-intro"))return;s.setItem("sc-intro","1");d.classList.add("intro");setTimeout(function(){if(d.dataset.intro!=="playing")d.classList.remove("intro")},2500)}catch(e){}})(document.documentElement)`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		{expect && <link rel="expect" href={`#${expect}`} blocking="render" />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preload" href={url("/fonts/barlow-600.woff2")} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={url("/fonts/plex-sans-var.woff2")} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={url("/fonts/plex-mono-400.woff2")} as="font" type="font/woff2" crossorigin />
		<meta name="description" content={description} />
		<link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
		<link rel="icon" href={url("/favicon-48.png")} type="image/png" sizes="48x48" />
		<link rel="apple-touch-icon" href={url("/apple-touch-icon.png")} />
		<meta name="theme-color" content="#10243a" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={image} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="SolidCraft, open-source parametric CAD, built in Rust" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={image} />
		<script type="application/ld+json" set:html={JSON.stringify(data)} />
		<script is:inline>document.documentElement.classList.add("js");</script>
		{hero && <script is:inline set:html={gate} />}
		<script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<BrandSprite />
		<Backdrop field={hero} />
		<Bar />
		<slot />
		<Footer />
		<script>
			import "../scripts/reveal";
			import "../scripts/scroll-fallback";
			import "../scripts/field";
			import "../scripts/cursor";
		</script>
	</body>
</html>
