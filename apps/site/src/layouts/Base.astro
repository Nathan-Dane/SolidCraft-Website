---
import Backdrop from "../components/Backdrop.astro";
import Bar from "../components/Bar.astro";
import BrandSprite from "../components/BrandSprite.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

import { site } from "../data/site";

interface Props {
	title: string;
	description?: string;
	/** The page has the hero, so the backdrop carries the field. */
	hero?: boolean;
	/** The id of the element that ends the content the first paint needs; the page is not painted before it is parsed. */
	expect?: string;
}

const { title, description = site.description, expect, hero = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const speculation = { prefetch: [{ where: { href_matches: "/*" }, eagerness: "moderate" }] };
const data = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: site.name,
	url: site.url,
	description,
	publisher: { "@type": "Organization", name: "Tangency Labs" },
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		{expect && <link rel="expect" href={`#${expect}`} blocking="render" />}
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preload" href="/fonts/barlow-600.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/plex-sans-var.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/plex-mono-400.woff2" as="font" type="font/woff2" crossorigin />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#10243a" />
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<script type="application/ld+json" set:html={JSON.stringify(data)} />
		<script is:inline>document.documentElement.classList.add("js");</script>
		<script type="speculationrules" is:inline set:html={JSON.stringify(speculation)} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<BrandSprite />
		<Backdrop field={hero} />
		<Bar />
		<slot />
		<Footer />
		<script>
			import "../scripts/reveal";
			import "../scripts/scroll-fallback";
			import "../scripts/field";
		</script>
	</body>
</html>
