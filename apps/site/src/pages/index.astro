---
import { getCollection } from "astro:content";
import Hero from "../components/Hero.astro";
import HomeSection from "../components/HomeSection.astro";
import ReleaseLine from "../components/ReleaseLine.tsx";
import Satellites from "../components/Satellites.astro";
import Base from "../layouts/Base.astro";

const sections = (await getCollection("home")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="SolidCraft: free, open-source parametric 3D CAD" expect="top-end" hero>
	<main id="main" class="page">
		<Satellites />
		<Hero>
			<ReleaseLine client:idle />
		</Hero>
		{sections.map((entry) => <HomeSection entry={entry} />)}
	</main>
</Base>
