---
import { getCollection } from "astro:content";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import HomeSection from "../components/HomeSection.astro";
import ReleaseLine from "../components/ReleaseLine.tsx";
import Base from "../layouts/Base.astro";

const sections = (await getCollection("home")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="SolidCraft — open-source parametric CAD, built in Rust" expect="top-end">
	<main id="main" class="page">
		<Hero>
			<ReleaseLine client:idle />
		</Hero>
		{sections.map((entry) => <HomeSection entry={entry} />)}
	</main>
	<Footer />
</Base>
