{
	"name": "solidcraft-website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@12.8.1",
	"engines": {
		"node": ">=24.10.0 <25"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.5",
		"typescript": "6.0.3"
	},
	"scripts": {
		"dev": "pnpm --filter @solidcraft/site dev",
		"build": "pnpm --filter @solidcraft/site build",
		"typecheck": "pnpm -r --if-present typecheck",
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"format": "biome format --write ."
	}
}
